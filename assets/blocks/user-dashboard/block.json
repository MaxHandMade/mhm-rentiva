{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mhm-rentiva/user-dashboard",
    "title": "MHM User Dashboard (deprecated)",
    "category": "widgets",
    "icon": "admin-users",
    "description": "Deprecated: this block renders a notice pointing customers to the WooCommerce account page. It will be removed in 7.0.",
    "textdomain": "mhm-rentiva",
    "supports": {
        "html": false,
        "inserter": false,
        "anchor": true,
        "className": true,
        "customClassName": true,
        "align": [
            "wide",
            "full",
            "center"
        ],
        "color": {
            "text": true,
            "background": true,
            "link": true,
            "gradients": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontFamily": true,
            "__experimentalFontWeight": true
        }
    },
    "attributes": {
        "className": {
            "type": "string",
            "default": ""
        }
    }
}
