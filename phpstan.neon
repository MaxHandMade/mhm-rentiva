# phpstan-baseline.neon is a QUEUE, not an accept-list. Two separate audit
# rounds found a real bug hiding inside it, so a count that grows without a
# reason written down is itself a finding.
#
# Entries whose reason lives in the code rather than here, because
# --generate-baseline rewrites this file and would drop a comment placed in it:
#   deadCode.unreachable, src/Admin/Frontend/Account/AccountController.php,
#   count 2 -- deliberate guards after wp_die()/wp_send_json_success(). Both
#   lines carry the reasoning at the site. Slice 5 raised this from 1 to 2.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    parallel:
        maximumNumberOfProcesses: 2
    paths:
        - src
        - mhm-rentiva.php
        - uninstall.php
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    excludePaths:
        - src/**/node_modules/*
    treatPhpDocTypesAsCertain: false
    scanDirectories:
        - vendor/wpackagist-plugin/elementor
    scanFiles:
        - vendor/mhm/ui-core/register.php
        - vendor/mhm/ui-core/bootstrap.php
    ignoreErrors:
        # The wordpress-stubs type update_metadata_by_mid()'s $meta_value as
        # string; core serializes any value itself ("Must be serializable if
        # non-scalar"), and a pre-serialized string would be serialized twice.
        # Here, not inline: the level-0 pass (phpstan-level0.neon) reports no
        # argument.type, so an inline ignore would be unmatched there.
        -
            identifier: argument.type
            message: '#^Parameter \#3 \$meta_value of function update_metadata_by_mid expects string, array<mixed, mixed> given\.$#'
            path: src/Admin/Payment/WooCommerce/WooCommerceBridge.php
            count: 1
