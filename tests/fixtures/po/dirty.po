# Fixture for bin/check-po-untranslated.php -- exactly SIX untranslated entries,
# one per shape. Each msgid names the shape so a report can be checked by name.
msgid ""
msgstr ""
"Project-Id-Version: fixture\n"
"Language: tr_TR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

#: src/Example.php:10
msgid "Translated control entry"
msgstr "Çevrilmiş kontrol girdisi"

#. Shape 1: an empty msgstr.
#: src/Example.php:20
msgid "SHAPE-EMPTY-MSGSTR"
msgstr ""

#. Shape 2: a multi-line msgid, untranslated. Its first line is msgid "" --
#. an earlier draft read that as the header and skipped the entry.
#: src/Example.php:30
msgid ""
"SHAPE-MULTILINE-MSGID first line, "
"and its second line"
msgstr ""

#. Shape 3: a plural entry whose msgstr[1] does not exist at all.
#: src/Example.php:40
msgid "SHAPE-MISSING-PLURAL-FORM %d"
msgid_plural "SHAPE-MISSING-PLURAL-FORM %d plural"
msgstr[0] "%d çoğul"

#. Shape 4: no msgstr key at all.
#: src/Example.php:50
msgid "SHAPE-NO-MSGSTR-KEY"

#. Shape 5: translated, but flagged fuzzy -- a GUESS. Unlike msgfmt, `wp i18n make-mo` and
#. `make-php` ship it as if reviewed: gettext's Po extractor stores `fuzzy` as a flag only,
#. and the generators skip only disabled (#~) or empty entries. Measured in the installed
#. WP-CLI phar, 2026-09-13.
#, fuzzy
#: src/Example.php:60
msgid "SHAPE-FUZZY"
msgstr "Bulanık"

#. Shape 6: untranslated, and its msgid carries U+2705 (bytes E2 9C 85). 0x85 is NEL;
#. `preg_split('/\R/')` without /u cut this line in two and the entry was never read.
#. Found by counting: the gate scanned 3252 of Lite's 3253 live entries, 1766 of Pro's 1768.
#: src/Example.php:70
msgid "SHAPE-NEL-BYTE ✅ License successfully activated!"
msgstr ""
