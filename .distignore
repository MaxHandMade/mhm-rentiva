# Carve-out tooling + inventories. MUST NOT ship: Plugin Check rejects the .sh
# scripts ("application_detected"), and pro-inventory.txt / lite-manifest-*.txt
# enumerate the paid edition's file list — an IP disclosure to every user.
carveout/
# Static-analysis config is dev-only (phpstan-baseline.neon alone is ~68 KB).
phpstan.neon
phpstan-level0.neon
phpstan-baseline.neon

# Build & Dependencies
# NOTE: leading "/" anchors to plugin root — otherwise "vendor/" would also
# exclude any in-tree assets/js/vendor/ directory if one were re-introduced.
# `/vendor/*` (not `/vendor/`) + a negation is deliberate: gitignore-style
# tools refuse to re-include a path whose *parent directory* itself is
# excluded, so excluding "/vendor/" outright would make the "!" line below
# a no-op. mhm/ui-core is a real runtime dependency as of mhm-rentiva.php's
# mhmuicore_register() call (Faz 0 Task 7) — it must ship in the release
# ZIP, unlike the rest of vendor/ which is dev-tooling only (PHPUnit,
# PHPCS, PHPStan, etc.).
/vendor/*
!/vendor/mhm/
# The blanket re-inclusion above ships the whole vendor/mhm/ui-core Composer
# package (a real runtime dependency), but that package carries its own
# dev-only files (CI workflow, static-analysis/test config) which came in via
# the upstream repo, not this plugin's own tooling exclusions above. Because
# .distignore uses "last match wins" (gitignore semantics), these patterns
# must be listed AFTER "!/vendor/mhm/" to re-exclude just those dev files
# while keeping the package's runtime PHP shipped.
/vendor/mhm/ui-core/.github/
/vendor/mhm/ui-core/.gitattributes
/vendor/mhm/ui-core/.gitignore
/vendor/mhm/ui-core/phpstan.neon
/vendor/mhm/ui-core/phpcs.xml
/vendor/mhm/ui-core/phpcs.xml.dist
/vendor/mhm/ui-core/phpunit.xml
/vendor/mhm/ui-core/phpunit.xml.dist
/vendor/mhm/ui-core/tests/
# Defence in depth: the package's own .gitattributes already export-ignores
# these dev-surface paths, so a normal (dist) `composer install` never puts
# them in vendor/ at all. They only matter for a --prefer-source install, or
# if the package's export-ignore list ever regresses. Must be listed here,
# AFTER "!/vendor/mhm/", for the same last-match-wins reason as above.
/vendor/mhm/ui-core/bin/
/vendor/mhm/ui-core/package.json
/vendor/mhm/ui-core/package-lock.json
/vendor/mhm/ui-core/.eslintrc.js
/vendor/mhm/ui-core/.stylelintrc.json
/vendor/mhm/ui-core/jest.config.js

# ui-core 0.9.1 brought five paths that have no runtime path on a user's site.
# Derived, not blacklisted: everything else in the package ships, because the
# loader serves ONE copy site-wide -- pruning a runtime class here would make a
# sibling plugin's call fatal. These five are the exceptions, and each is named:
#
#   src/Cli/          WP-CLI commands. Safe to drop since ui-core 0.8.1, which
#                     stopped tying registration to WP_CLI's presence -- before
#                     that, dropping this directory cost the consumer `wp` itself.
#   PurityScanner     Ships the licence/limit vocabulary it hunts for
#                     ('upgrade_to_pro', 'is_pro_active', 'license_server', ...).
#                     A reviewer grepping this free plugin's ZIP would read those
#                     words as an edition check regardless of the file's purpose.
#   ProLock.jsx       Carries the .mhmui-pro-lock class; same grep, same reading.
#   assets/react/pro.css  The stylesheet for that class.
#
# Measured 2026-09-06: nothing in ui-core or in either Rentiva tree enqueues
# pro.css or imports ProLock, and the scanner is a CI tool, not a runtime one.
/vendor/mhm/ui-core/src/Cli/
/vendor/mhm/ui-core/src/Seam/PurityScanner.php
/vendor/mhm/ui-core/src-react/components/ProLock.jsx
/vendor/mhm/ui-core/assets/react/pro.css
node_modules/
build/zip-staging
composer.lock
package.json
package-lock.json
webpack.config.js
gulpfile.js

# src-react/ INTENTIONALLY NOT excluded — shared/admin.css is enqueued
# directly by VehicleColumns.php, BookingColumns.php, AddonListTable.php,
# and TransferAdmin.php on PHP list-table pages. Excluding src-react/
# would 404 those styles and break KPI cards on installed sites.
# (Future option: move shared/admin.css into the wp-scripts build output,
#  then src-react/ could be excluded — separate task, needs PHP+webpack changes.)

