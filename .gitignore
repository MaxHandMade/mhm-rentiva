# package-lock.json IS tracked: a pinned lockfile is required for a
# reproducible `npm ci` + `npm run build`, which the deterministic i18n
# recipe (bin/build-i18n.py) and release builds depend on.

# Composer (vendor is excluded, but composer.json is tracked for CI)
vendor/
# Re-include plugin source directories whose names collide with 'vendor/' on case-insensitive filesystems (Windows)
!src/Admin/Vendor/
!src/Admin/Vendor/**
!src/Admin/Frontend/Shortcodes/Vendor/
!src/Admin/Frontend/Shortcodes/Vendor/**
!tests/Integration/Vendor/
!tests/Integration/Vendor/**
# Re-include browser-shipped vendor bundles (flatpickr, swiper) — same pattern
# as !assets/js/vendor/chart.min.js. Without this, the global vendor/ rule
# above also matches assets/vendor/ and the bundles get dropped from clean
# clones (2026-05-16 host plugin dir incident silently wiped them).
!assets/vendor/
!assets/vendor/**
!tests/Integration/Admin/Vendor/
!tests/Integration/Admin/Vendor/**
!tests/Admin/Vendor/
!tests/Admin/Vendor/**
!tests/Admin/Frontend/Shortcodes/Vendor/
!tests/Admin/Frontend/Shortcodes/Vendor/**
.phpunit.result.cache

